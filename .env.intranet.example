# =====================================================================
# 内网版站点差异（覆盖基础 .env / .env.template 的站点相关项）
#
# 物理隔离：不访问外网、无外部搜索引擎、模型走内网网关、登录走内部 SSO。
# 用法：复制为 .env.intranet（已被 .gitignore 忽略），配合基础 .env 使用。
# 注入：部署时让服务追加读取本文件（override 里 `env_file: [.env, .env.intranet]`，或改 compose 的 env_file 列表）。
# =====================================================================

# --- 认证：内部 SSO（OIDC）---
# 内网 SSO 若暴露 discovery，只填 OIDC_ISSUER_URL；否则用下面三个端点绕过 discovery。
OIDC_ENABLED=true
OIDC_PROVIDER_NAME=内部账号登录
OIDC_ISSUER_URL=
OIDC_AUTHORIZATION_ENDPOINT=http://<internal-sso>/authorize
OIDC_TOKEN_ENDPOINT=http://<internal-sso>/token
OIDC_USERINFO_ENDPOINT=http://<internal-sso>/userinfo
OIDC_CLIENT_ID=<internal-client-id>
OIDC_CLIENT_SECRET=<internal-client-secret>
OIDC_REDIRECT_URI=http://<internal-domain>/api/auth/oidc/callback
OIDC_USE_RAW_USERNAME=true
OIDC_FETCH_DEPARTMENT_INFO=true
OIDC_DEPARTMENT_CLAIM=department

# --- 搜索：内部搜索引擎（占位，后端待定：Meilisearch / 企业搜索）---
# 对应代码 tools.py 的 _WEB_SEARCH_PROVIDERS["internal"]；后端定了再填工厂实现。
WEB_SEARCH_PROVIDER=internal
INTERNAL_SEARCH_API_KEY=<internal-search-key>
INTERNAL_SEARCH_URL=http://<internal-search-host>    # 内部搜索服务地址（待定）

# --- 模型：内网模型网关（OpenAI 兼容）---
# 在 DB「模型供应商」页新增一个自定义 provider，base_url 填内网网关（如 vLLM/Ollama 的 /v1）。
# api_key 可直接填 DB，或用 api_key_env 指向下面这个环境变量名。
INTERNAL_LLM_API_KEY=<internal-llm-key>

# --- 品牌 ---
YUXI_BRAND_FILE_PATH=package/yuxi/config/static/info.intranet.yaml

# --- 内网出口收紧 ---
YUXI_URL_WHITELIST=                                  # 清空，禁止外网 URL 解析/抓取
