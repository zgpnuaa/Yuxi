# =====================================================================
# 公网版站点差异（覆盖基础 .env / .env.template 的站点相关项）
#
# 用法：复制为 .env.public（已被 .gitignore 忽略），配合基础 .env 使用。
# 注入：部署时让服务追加读取本文件（override 里 `env_file: [.env, .env.public]`，或改 compose 的 env_file 列表）。
# 说明：env_file 同名键「后者覆盖前者」，本文件只列公网与内网有差异的项。
# =====================================================================

# --- 认证：手机号 / 微信登录（接现成认证云，如 Authing / Auth0）---
# Yuxi 侧零代码：标准 OIDC，认证云负责手机号验证码 + 微信扫码。
OIDC_ENABLED=true
OIDC_PROVIDER_NAME=手机号/微信登录                # 前端登录按钮显示名
OIDC_ISSUER_URL=https://<tenant>.authing.cn/oidc  # 认证云 issuer（若暴露 discovery 只填这项）
# OIDC_AUTHORIZATION_ENDPOINT=                    # 若认证云不暴露 discovery，改用下面三个端点
# OIDC_TOKEN_ENDPOINT=
# OIDC_USERINFO_ENDPOINT=
OIDC_CLIENT_ID=<authing-client-id>
OIDC_CLIENT_SECRET=<authing-client-secret>
OIDC_REDIRECT_URI=https://<public-domain>/api/auth/oidc/callback
OIDC_SCOPES=openid profile phone
OIDC_AUTO_CREATE_USER=true
OIDC_DEFAULT_ROLE=user
OIDC_USERNAME_CLAIM=sub                           # 认证云返回的用户唯一标识

# --- 搜索：外部搜索引擎 ---
WEB_SEARCH_PROVIDER=tavily                        # tavily | doubao
TAVILY_API_KEY=<tavily-api-key>
# DOUBAO_SEARCH_API_KEY=                          # 若改用豆包

# --- 模型：外部 API ---
# 模型供应商在 DB「模型供应商」页配置；api_key_env 指向下面的环境变量名。
DASHSCOPE_API_KEY=<dashscope-key>
DEEPSEEK_API_KEY=<deepseek-key>
SILICONFLOW_API_KEY=<siliconflow-key>

# --- 品牌 ---
YUXI_BRAND_FILE_PATH=package/yuxi/config/static/info.public.yaml
